# ─────────────────────────────────────────────
# 쉬운 생활법령 RSS 알림 — 환경 변수 설정 예시
# 이 파일을 복사하여 .env 로 저장한 뒤 값을 채워넣으세요.
# ─────────────────────────────────────────────

# SMTP 서버 설정
# Gmail 사용 시: smtp.gmail.com / 587
# Naver 사용 시: smtp.naver.com / 587
# Daum  사용 시: smtp.daum.net  / 465
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# 발신 이메일 계정
SMTP_USER=your-email@gmail.com

# Gmail: Google 계정 > 보안 > 앱 비밀번호 생성 후 입력
# Naver: 네이버 메일 설정 > POP3/SMTP 사용 > 비밀번호 입력
SMTP_PASSWORD=your-app-password

# 알림 수신 이메일 (쉼표로 여러 개 지정 가능)
# 예: NOTIFY_EMAIL=a@example.com,b@example.com
NOTIFY_EMAIL=recipient@example.com

# ─────────────────────────────────────────────
# Slack 알림 (선택 사항 — 이메일 없이 Slack만 사용 가능)
# ─────────────────────────────────────────────
# 발급 방법:
#   1. https://api.slack.com/apps 에서 앱 생성
#   2. "Incoming Webhooks" 기능 활성화
#   3. "Add New Webhook to Workspace" 로 채널 선택
#   4. 생성된 URL 복사
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
